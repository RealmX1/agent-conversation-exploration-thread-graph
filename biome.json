{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useConst": "error"
			}
		}
	},
	"files": {
		"includes": [
			"src/**/*.ts",
			"test/**/*.ts",
			"vitest.config.ts",
			"package.json",
			"tsconfig.json",
			"tsconfig.build.json",
			"biome.json",
			"!dist/**/*",
			"!node_modules/**/*"
		]
	}
}
